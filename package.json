    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
